* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf

# Cross-platform source and launchers
*.js text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.ps1 text eol=lf
*.swift text eol=lf
*.sql text eol=lf
*.svg text eol=lf

# Native Windows launchers
*.cmd text eol=crlf
*.bat text eol=crlf

