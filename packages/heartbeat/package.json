{
  "name": "@xiaoshe/heartbeat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@xiaoshe/runtime-contract": "workspace:*",
    "@xiaoshe/verification-policy": "workspace:*"
  },
  "scripts": {
    "build": "node ./scripts/build-client.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
