{
  "name": "@xiaoshe/provider-readiness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "build": "node ./scripts/build-client.mjs && tsc -p tsconfig.build.json",
    "test": "npm run build && node ./scripts/build-test-client.mjs && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xiaoshe/runtime-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dsh": {
    "client": {
      "inject": ["@xiaoshe/runtime-dsh-provider", "@deepseek-ai/dsh-api-remotes"],
      "platform": "web"
    }
  }
}
