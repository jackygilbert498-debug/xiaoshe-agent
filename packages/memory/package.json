{
  "name": "@xiaoshe/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./service": { "types": "./lib/service.d.ts", "default": "./lib/service.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "build": "node ./scripts/build-client.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dsh": {
    "client": { "inject": [], "platform": "web", "immediately": true }
  }
}
