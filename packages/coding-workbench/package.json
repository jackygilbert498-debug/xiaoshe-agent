{
  "name": "@xiaoshe/coding-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "build": "node ./scripts/build-client.mjs && tsc -p tsconfig.build.json",
    "test": "node ./scripts/build-client.mjs && tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@xiaoshe/runtime-contract": "workspace:*" },
  "devDependencies": { "@types/node": "22.19.7", "typescript": "5.9.3" },
  "dsh": { "client": { "inject": ["@xiaoshe/runtime-dsh-provider"], "platform": "web" } }
}
