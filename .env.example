# Copy this file to .env and fill only your own credentials.
# .env is ignored by Git and must never be committed.

# Default provider for new sessions: deepseek or kimi
MODEL_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PROXY=

# Kimi (optional; can coexist with DeepSeek)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding
KIMI_PROXY=

# Extra models exposed in the model menu
XS_MODELS=deepseek-v4-pro

# Runtime E0-E4 flags: off, shadow, or on
XIAOSHE_RUNTIME_E0_REQUEST_LEDGER=shadow
XIAOSHE_RUNTIME_E1_TOOL_EPOCH=shadow
XIAOSHE_RUNTIME_E2_PREFIX_EPOCH=shadow
XIAOSHE_RUNTIME_E3_COMPLETION_GATE=shadow
XIAOSHE_RUNTIME_E4_MODEL_ROUTING=off

# Tool network policy: off, proxy, or open
# off is the safe default. open allows trusted local tasks to access the network.
TOOL_NET_MODE=off
TOOL_NET_ALLOW=

# Sandbox backend: auto, docker, seatbelt, appcontainer, or bare
SANDBOX_BACKEND=auto
SANDBOX_DOCKER_IMAGE=python:3-slim
