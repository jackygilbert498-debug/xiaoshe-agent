# 复制为 .env 并填入你的值（.env 已被 .gitignore 忽略，绝不提交到 git）。
# 优先级：环境变量 > .env > 代码内置默认。
KIMI_API_KEY=在此填入你的 Kimi(sk-kimi-...) key
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding
# 界面模型下拉的候选清单（逗号分隔，可选项；当前 KIMI_MODEL 恒在首位不用重复写）。
# 不配 = 单模型，界面 pill 如实降级为不可点。界面切换只是会话级，不落回本文件，重启回 KIMI_MODEL。
#XS_MODELS=k2-thinking,k2-instruct
# 本机若需经本地代理访问 api.kimi.com，在此填代理地址；不需要就留空
KIMI_PROXY=http://127.0.0.1:7897

# ── V1 统一 RuntimeSession（默认 shadow；当前版本不要在日常使用中切到 on）──
# off = 完整旧路径；shadow = 生成安全对照但仍由旧路径执行；on = 仅受控测试统一 runner。
XIAOSHE_RUNTIME_SESSION=shadow


# ── V2 RuntimeEvent（默认 off：完整保留旧路径；shadow 仅记录安全对照；on 留给受控测试）──
XIAOSHE_RUNTIME_EVENTS=off

# ── D1-1b 工具子进程出网管控（run_command / run_in_background）──
# off（默认）= 子进程环境擦除（剔凭据/继承代理）+ 代理变量指死地址 = 零出网（fail-closed 安全默认）；
# proxy = 出网经本地 FilterProxy 按 TOOL_NET_ALLOW 白名单过滤（白名单空=全拒），放行流量级联 KIMI_PROXY；
# open = 旧行为（继承全量环境、出网不受控）——仅本地信任场景显式降级。
TOOL_NET_MODE=off
# 逗号分隔白名单域名；.example.com 匹配子域及本体。默认空 = 全拒。
TOOL_NET_ALLOW=

# ── S2 沙箱后端选择（Docker 沙箱化执行 · 优雅降级版，harness/sandbox.py）──
# auto（默认）= 破坏性 shell 命令优先跑一次性 Docker 容器；Docker 缺席自动降级
#   （Mac→seatbelt / Win→AppContainer / 都没有→裸跑），降级路径返回值 annotation 显式标注
#   「未隔离」，不装隔离；
# docker = 强制容器（缺席直接报错，fail-closed 不静默降级）；
# seatbelt / appcontainer = 强制对应 OS 沙箱；bare = 显式裸跑（零隔离，仅本地可信场景）。
SANDBOX_BACKEND=auto
# Docker 后端镜像（通用最小镜像；容器内默认断网、内存/pids 封顶、根 fs 只读、只 /work 可写）。
SANDBOX_DOCKER_IMAGE=python:3-slim

# ── 飞书受控任务收件入口（默认关闭）──
# 凭据值不要写进本文件；先写入本机 .state/feishu_secrets.bin 的 SecretStore，再只引用名称。
# 只有开关、两项凭据引用、项目和全部白名单都完整时才注册回环 webhook 路由。
FEISHU_INBOX_ENABLED=false
FEISHU_VERIFICATION_TOKEN_REF=feishu-verification-token
FEISHU_ENCRYPT_KEY_REF=feishu-encrypt-key
FEISHU_TENANT_KEY=
FEISHU_APP_ID=
FEISHU_BOT_OPEN_ID=
FEISHU_PROJECT_ID=
FEISHU_ALLOWED_SENDERS=
FEISHU_ALLOWED_CHATS=
FEISHU_TIMESTAMP_WINDOW_SECONDS=300
FEISHU_NONCE_LEDGER_LIMIT=10000
