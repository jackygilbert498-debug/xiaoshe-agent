# Copy this file to .env and fill in local values. Never commit the resulting .env.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

# Optional comma-separated model choices shown by the legacy compatibility UI.
# XS_MODELS=k2-thinking,k2-instruct

# Optional outbound proxy for the legacy model client.
KIMI_PROXY=

# Child-process network policy: off (default), proxy, or open.
TOOL_NET_MODE=off
TOOL_NET_ALLOW=

# Sandbox backend: auto, docker, seatbelt, appcontainer, or bare.
SANDBOX_BACKEND=auto
SANDBOX_DOCKER_IMAGE=python:3-slim

# Optional Feishu inbox integration. Store credential values in the local
# SecretStore and reference their names here; do not place secrets in this file.
FEISHU_INBOX_ENABLED=false
FEISHU_VERIFICATION_TOKEN_REF=feishu-verification-token
FEISHU_ENCRYPT_KEY_REF=feishu-encrypt-key
FEISHU_TENANT_KEY=
FEISHU_APP_ID=
FEISHU_BOT_OPEN_ID=
FEISHU_PROJECT_ID=
FEISHU_ALLOWED_SENDERS=
FEISHU_ALLOWED_CHATS=
FEISHU_TIMESTAMP_WINDOW_SECONDS=300
FEISHU_NONCE_LEDGER_LIMIT=10000
