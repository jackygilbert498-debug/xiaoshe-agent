{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小蛇",
  "version": "0.1.0",
  "identifier": "com.xiaoshe.app",
  "build": {
    "frontendDist": "./web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小蛇",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:7788 ws://127.0.0.1:7788 http://localhost:7788 ws://localhost:7788; font-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "小蛇桌面端",
    "longDescription": "小蛇桌面壳：系统 WebView 渲染 run.py serve 的本机 Web UI。",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
